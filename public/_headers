# Cloudflare headers.
#
# This concept/demo is not indexed. When cloning for a real bakery and setting
# `indexable: true` in src/data/site.ts, remove the X-Robots-Tag line below so the
# site can appear in search results.
/*
  X-Robots-Tag: noindex, nofollow

# Astro content-hashed assets — safe to cache immutably for repeat visits.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
