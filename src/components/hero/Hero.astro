---
import { Image } from "astro:assets";

import heroImage from "../../assets/hero.jpg";
import { site, type Locale } from "../../data/site";
import { useTranslations } from "../../i18n/utils";
import { buildWhatsAppUrl } from "../../lib/whatsapp";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const variant = site.heroVariant;
const tagline = site.tagline[lang] ?? site.tagline.en;
const whatsappUrl = buildWhatsAppUrl(t("msg.intro"));
---

{
  variant === "classic" && (
    <section class="relative isolate overflow-hidden">
      <Image
        src={heroImage}
        alt=""
        widths={[480, 960, 1440, 1680]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        class="absolute inset-0 -z-10 h-full w-full object-cover object-[68%_50%] sm:object-center"
      />
      <div class="absolute inset-0 -z-10 bg-black/40" />
      <div class="container-page flex min-h-[65vh] flex-col items-center justify-center py-20 text-center text-white">
        <span class="badge bg-white/20 text-white">{t("hero.eyebrow")}</span>
        <h1 class="mt-3 font-heading text-4xl sm:text-6xl">{site.name}</h1>
        <p class="mt-3 max-w-xl text-lg text-white/90">{tagline}</p>
        <div class="mt-6 flex flex-wrap justify-center gap-3">
          <a href="#menu" class="btn btn-primary">
            {t("hero.cta")}
          </a>
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn bg-white text-text"
          >
            {t("hero.secondary")}
          </a>
        </div>
      </div>
    </section>
  )
}

{
  variant === "overlay" && (
    <section class="relative isolate overflow-hidden">
      <Image
        src={heroImage}
        alt=""
        widths={[480, 960, 1440, 1680]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        class="absolute inset-0 -z-10 h-full w-full object-cover object-[68%_50%] sm:object-center"
      />
      <div class="absolute inset-0 -z-10 bg-black/55 sm:bg-transparent sm:bg-linear-to-r sm:from-black/75 sm:via-black/30 sm:to-transparent" />
      <div class="container-page flex min-h-[72vh] flex-col justify-center py-20 text-white">
        <span class="badge w-fit bg-white/20 text-white">
          {t("hero.eyebrow")}
        </span>
        <h1 class="mt-3 max-w-xl font-heading text-4xl text-shadow-sm text-shadow-black/30 sm:text-6xl">
          {site.name}
        </h1>
        <p class="mt-3 max-w-lg text-lg text-white/90 text-shadow-sm text-shadow-black/40">
          {tagline}
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="#menu" class="btn btn-primary">
            {t("hero.cta")}
          </a>
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn bg-white text-text"
          >
            {t("hero.secondary")}
          </a>
        </div>
      </div>
    </section>
  )
}

{
  variant === "split" && (
    <section class="container-page grid items-center gap-8 py-14 md:grid-cols-2">
      <div>
        <span class="badge bg-surface-alt text-text">{t("hero.eyebrow")}</span>
        <h1 class="mt-3 font-heading text-4xl sm:text-5xl">{site.name}</h1>
        <p class="mt-3 max-w-xl text-lg text-text-muted">{tagline}</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="#menu" class="btn btn-primary">
            {t("hero.cta")}
          </a>
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn-outline"
          >
            {t("hero.secondary")}
          </a>
        </div>
      </div>
      <Image
        src={heroImage}
        alt=""
        widths={[480, 960, 1440]}
        sizes="(min-width: 768px) 50vw, 100vw"
        loading="eager"
        class="w-full rounded-lg border border-border object-cover"
      />
    </section>
  )
}

{
  variant === "menu-first" && (
    <section class="container-page py-8 text-center">
      <span class="badge bg-surface-alt text-text">{t("hero.eyebrow")}</span>
      <h1 class="mt-2 font-heading text-3xl sm:text-5xl">{site.name}</h1>
      <p class="mx-auto mt-2 max-w-xl text-text-muted">{tagline}</p>
      <div class="mt-4 flex flex-wrap justify-center gap-3">
        <a href="#menu" class="btn btn-primary">
          {t("hero.cta")}
        </a>
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-outline"
        >
          {t("hero.secondary")}
        </a>
      </div>
    </section>
  )
}
