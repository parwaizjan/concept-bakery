---
import type { Locale } from "../../data/site";
import type { MenuItem } from "../../lib/menu";
import { formatPrice } from "../../lib/format";
import { useTranslations } from "../../i18n/utils";
import ProductImage from "./ProductImage.astro";

interface Props {
  item: MenuItem;
  lang: Locale;
}

const { item, lang } = Astro.props;
const t = useTranslations(lang);
---

<article
  class:list={[
    "card flex h-full flex-col overflow-hidden",
    !item.available && "opacity-60",
  ]}
  data-product
  data-id={item.id}
  data-name={item.name}
  data-price={item.price}
  data-available={String(item.available)}
  data-category={item.category}
>
  <div class="aspect-[4/3] overflow-hidden bg-surface-alt">
    <ProductImage
      image={item.image}
      alt={item.name}
      class="h-full w-full object-cover"
    />
  </div>

  <div class="flex flex-1 flex-col gap-1 p-3">
    <div class="flex items-start justify-between gap-2">
      <h3 class="font-heading text-lg leading-tight">{item.name}</h3>
      <span
        data-sold-out
        hidden={item.available}
        class="badge shrink-0 bg-danger text-white">{t("menu.soldOut")}</span
      >
    </div>

    {
      item.description && (
        <p class="text-sm text-text-muted">{item.description}</p>
      )
    }

    {item.note && <p class="text-xs font-medium text-accent">{item.note}</p>}

    <div class="mt-auto flex items-center justify-between gap-2 pt-2">
      <span data-price-display class="font-semibold"
        >{formatPrice(item.price)}</span
      >
      <button
        type="button"
        class="btn btn-primary"
        data-add={item.id}
        disabled={!item.available}
        aria-label={`${t("menu.add")} ${item.name}`}
      >
        {t("menu.add")}
      </button>
    </div>
  </div>
</article>
