---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getEntry, render } from "astro:content";
import { gallery } from "../../data/gallery";
import { type Locale } from "../../data/site";
import { useTranslations } from "../../i18n/utils";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const entry =
  (await getEntry("pages", `gallery/${lang}`)) ??
  (await getEntry("pages", "gallery/en"));

const rendered = entry ? await render(entry) : null;
const Content = rendered?.Content;
---

<BaseLayout lang={lang} path="/gallery" title={entry?.data.title}>
  <section class="container-page py-12">
    <h1 class="font-heading text-4xl">{entry?.data.title}</h1>
    <div class="mt-3 max-w-2xl leading-relaxed text-text-muted">
      {Content && <Content />}
    </div>

    <div class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-3">
      {
        gallery.map((image) => (
          <Image
            src={image.src}
            alt={t(image.altKey)}
            widths={[300, 600]}
            sizes="(min-width: 640px) 20rem, 45vw"
            loading="lazy"
            class="aspect-square w-full rounded-md border border-border object-cover"
          />
        ))
      }
    </div>
  </section>
</BaseLayout>
