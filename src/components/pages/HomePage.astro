---
import { Image } from "astro:assets";

import aboutImage from "../../assets/about.jpg";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../hero/Hero.astro";
import Menu from "../menu/Menu.astro";
import BestSellers from "../menu/BestSellers.astro";
import OpeningHours from "../visit/OpeningHours.astro";
import MapEmbed from "../visit/MapEmbed.astro";
import ContactLinks from "../visit/ContactLinks.astro";
import { site, type Locale } from "../../data/site";
import { gallery } from "../../data/gallery";
import { getCategories, getMenu } from "../../lib/menu";
import { useTranslations, localizePath } from "../../i18n/utils";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const [items, categories] = await Promise.all([
  getMenu(lang),
  getCategories(lang),
]);
---

<BaseLayout lang={lang} path="/">
  <Hero lang={lang} />

  <section class="border-y border-border bg-surface py-4">
    <div
      class="container-page flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm"
    >
      <span class="text-text-muted"
        >{site.address[lang] ?? site.address.en}</span
      >
      {
        site.order.allowPickup && (
          <span class="badge bg-surface-alt text-text">
            {t("order.pickup")}
          </span>
        )
      }
      {
        site.order.allowDelivery && (
          <span class="badge bg-surface-alt text-text">
            {t("order.delivery")}
          </span>
        )
      }
    </div>
  </section>

  <Menu categories={categories} items={items} lang={lang} />

  <BestSellers items={items} lang={lang} />

  <section class="container-page grid items-center gap-8 py-12 md:grid-cols-2">
    <div>
      <h2 class="font-heading text-3xl">{t("about.title")}</h2>
      <p class="mt-3 text-text-muted">{t("about.teaser")}</p>
      <a href={localizePath("/about", lang)} class="btn btn-outline mt-5">
        {t("about.readMore")}
      </a>
    </div>
    <Image
      src={aboutImage}
      alt={t("about.imageAlt")}
      widths={[480, 800, 1200]}
      sizes="(min-width: 768px) 50vw, 100vw"
      loading="lazy"
      class="w-full rounded-lg border border-border object-cover"
    />
  </section>

  <section class="bg-surface-alt py-12">
    <div class="container-page">
      <h2 class="mb-4 font-heading text-2xl">{t("gallery.title")}</h2>
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
        {
          gallery.map((image) => (
            <Image
              src={image.src}
              alt={t(image.altKey)}
              widths={[300, 600]}
              sizes="(min-width: 640px) 20rem, 45vw"
              loading="lazy"
              class="aspect-square w-full rounded-md border border-border object-cover"
            />
          ))
        }
      </div>
    </div>
  </section>

  <section class="container-page py-12">
    <h2 class="mb-6 font-heading text-3xl">{t("visit.title")}</h2>
    <div class="grid gap-8 md:grid-cols-3">
      <ContactLinks lang={lang} />
      <OpeningHours lang={lang} />
      <MapEmbed lang={lang} />
    </div>
  </section>
</BaseLayout>
